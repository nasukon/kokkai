<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>統計検定1級 合格ロードマップ 2026</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <!-- Chosen Palette: Slate & Indigo -->
    <!-- Application Structure Plan: 
         1. Hero Section: Goal visualization (Countdown) and Motivation.
         2. Macro View (Dashboard): Overview of the 4 Phases and Resource Distribution (Charts).
         3. Phase Explorer (Interactive Tabs): Detailed breakdown of each phase, monthly tasks, and specific focus areas.
         4. Micro View (Weekly Routine): Interactive visualization of the weekly study rhythm (Night vs Commute).
         5. Resources & Tips: Prioritized list of materials and advice.
         Why: The user needs to switch between the "Big Picture" (1 year) and "Daily Action" (Weekly routine). The tabbed interface prevents information overload.
    -->
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;700&display=swap');
        
        body {
            font-family: 'Noto Sans JP', sans-serif;
            background-color: #f8fafc; /* Slate 50 */
            color: #334155; /* Slate 700 */
        }

        .chart-container {
            position: relative;
            width: 100%;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
            height: 300px;
            max-height: 400px;
        }

        /* Custom Scrollbar for inner content if needed */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9; 
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1; 
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8; 
        }

        .phase-btn.active {
            background-color: #4f46e5; /* Indigo 600 */
            color: white;
            border-color: #4f46e5;
        }
        
        .fade-in {
            animation: fadeIn 0.5s ease-in-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body class="antialiased min-h-screen flex flex-col">

    <!-- Navbar -->
    <nav class="bg-white shadow-sm border-b border-slate-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center gap-2">
                    <span class="text-2xl">📊</span>
                    <h1 class="text-xl font-bold text-slate-800 tracking-tight">統計検定1級 合格ナビ</h1>
                </div>
                <div class="text-sm font-medium text-slate-500 hidden sm:block">
                    目標: 2026年11月15日
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-grow container mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-12">

        <!-- Hero Section: Context & Countdown -->
        <section class="bg-white rounded-2xl shadow-lg p-6 md:p-10 border border-slate-100">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
                <div>
                    <div class="inline-block px-3 py-1 bg-indigo-100 text-indigo-700 rounded-full text-xs font-bold mb-4">工学部卒・社会人向けプラン</div>
                    <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">
                        苦手意識を克服し、<br><span class="text-indigo-600">1年で頂点</span>を目指す。
                    </h2>
                    <p class="text-slate-600 mb-6 leading-relaxed">
                        確率・統計への苦手意識があっても、工学部の数学基礎（微積・線形代数）があれば勝機は十分にあります。
                        無理のない週10時間の学習ペースで、基礎から応用（社会科学）まで確実に積み上げる戦略的ロードマップです。
                    </p>
                    <div class="flex gap-4">
                        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 text-center w-32">
                            <span class="block text-xs text-slate-500 uppercase font-semibold">残り日数</span>
                            <span id="days-remaining" class="text-3xl font-bold text-indigo-600">---</span>
                            <span class="text-xs text-indigo-600">日</span>
                        </div>
                        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 text-center flex-1">
                            <span class="block text-xs text-slate-500 uppercase font-semibold">ターゲット</span>
                            <div class="mt-1 font-medium text-slate-800">2026年11月15日 (日)</div>
                            <div class="text-xs text-slate-500 mt-1">統計応用：社会科学</div>
                        </div>
                    </div>
                </div>
                
                <!-- Visualization: Total Effort Breakdown -->
                <div class="bg-slate-50 rounded-xl p-4 border border-slate-200">
                    <h3 class="text-sm font-bold text-slate-700 mb-4 text-center">学習時間配分 (総計 約350時間)</h3>
                    <div class="chart-container" style="height: 250px;">
                        <canvas id="effortChart"></canvas>
                    </div>
                    <p class="text-xs text-slate-500 text-center mt-2">※フェーズ1・2の基礎固めに約7割の時間を投資</p>
                </div>
            </div>
        </section>

        <!-- Phase Navigator: The Core Interactive Section -->
        <section id="phase-navigator" class="scroll-mt-20">
            <div class="text-center mb-8">
                <h2 class="text-2xl font-bold text-slate-900">学習フェーズ詳細</h2>
                <p class="text-slate-500 mt-2">タブを切り替えて各期間の具体的な学習内容を確認してください</p>
            </div>

            <!-- Tabs -->
            <div class="flex flex-wrap justify-center gap-2 mb-8" id="phase-tabs">
                <button class="phase-btn active px-6 py-3 rounded-lg font-medium text-sm transition-all duration-200 border border-transparent bg-white shadow-sm hover:bg-indigo-50 text-slate-600" data-phase="1">
                    <span class="block text-xs opacity-70">Dec '25 - Mar '26</span>
                    フェーズ 1: 基礎固め
                </button>
                <button class="phase-btn px-6 py-3 rounded-lg font-medium text-sm transition-all duration-200 border border-transparent bg-white shadow-sm hover:bg-indigo-50 text-slate-600" data-phase="2">
                    <span class="block text-xs opacity-70">Mar - Jul '26</span>
                    フェーズ 2: 数理・理論
                </button>
                <button class="phase-btn px-6 py-3 rounded-lg font-medium text-sm transition-all duration-200 border border-transparent bg-white shadow-sm hover:bg-indigo-50 text-slate-600" data-phase="3">
                    <span class="block text-xs opacity-70">Jul - Oct '26</span>
                    フェーズ 3: 応用・過去問
                </button>
                <button class="phase-btn px-6 py-3 rounded-lg font-medium text-sm transition-all duration-200 border border-transparent bg-white shadow-sm hover:bg-indigo-50 text-slate-600" data-phase="4">
                    <span class="block text-xs opacity-70">Oct - Nov '26</span>
                    フェーズ 4: 総仕上げ
                </button>
            </div>

            <!-- Dynamic Content Area -->
            <div id="phase-content" class="bg-white rounded-2xl shadow-lg border border-slate-100 overflow-hidden min-h-[500px]">
                <!-- Content injected via JS -->
            </div>
        </section>

        <!-- Weekly Routine Strategy -->
        <section class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="lg:col-span-1 bg-white rounded-2xl shadow-md p-6 border border-slate-100">
                <h3 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
                    <span>⏰</span> 週間学習戦略
                </h3>
                <p class="text-sm text-slate-600 mb-6">
                    無理な早起きや通勤学習の強制は挫折のもと。
                    <span class="font-bold text-indigo-600">「夜の集中時間」</span>を主軸に、通勤はあくまでボーナスタイム（睡眠・休息OK）と割り切ることで、1年間の継続を可能にします。
                </p>
                <ul class="space-y-4 text-sm text-slate-700">
                    <li class="flex items-start gap-3">
                        <div class="w-8 h-8 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-600 font-bold shrink-0">夜</div>
                        <div>
                            <span class="font-bold block">22:30 - 24:00 (90分)</span>
                            メイン学習。演習、計算、論述。誰にも邪魔されない時間に集中。
                        </div>
                    </li>
                    <li class="flex items-start gap-3">
                        <div class="w-8 h-8 rounded-full bg-amber-100 flex items-center justify-center text-amber-600 font-bold shrink-0">昼</div>
                        <div>
                            <span class="font-bold block">昼休み (30分)</span>
                            インプット、復習。用語の確認や、夜に解いた問題の解説を読む。
                        </div>
                    </li>
                    <li class="flex items-start gap-3 opacity-75">
                        <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 font-bold shrink-0">移</div>
                        <div>
                            <span class="font-bold block">通勤 (任意 60分)</span>
                            <span class="inline-block bg-slate-100 text-slate-500 text-xs px-2 py-0.5 rounded">ボーナスタイム</span><br>
                            寝てもOK。元気なら暗記カードや軽い復習。
                        </div>
                    </li>
                </ul>
            </div>
            
            <div class="lg:col-span-2 bg-white rounded-2xl shadow-md p-6 border border-slate-100 flex flex-col justify-center">
                 <h3 class="text-sm font-bold text-slate-500 mb-2 text-center">理想的な週間ペース (目標: 週10時間)</h3>
                 <div class="chart-container w-full h-64 mx-auto">
                    <canvas id="weeklyChart"></canvas>
                 </div>
            </div>
        </section>

        <!-- Recommended Resources -->
        <section class="bg-indigo-50 rounded-2xl p-6 md:p-10 border border-indigo-100 mb-12">
            <h3 class="text-xl font-bold text-indigo-900 mb-6 flex items-center gap-2">
                <span>📚</span> 推奨リソース
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-white p-4 rounded-lg shadow-sm border border-indigo-50">
                    <div class="text-xs font-bold text-indigo-500 uppercase mb-1">フェーズ1 (必須)</div>
                    <div class="font-bold text-slate-800">統計検定2級 公式テキスト</div>
                    <p class="text-xs text-slate-500 mt-2">概念理解のバイブル。数式よりも「意味」を掴むことに注力。</p>
                </div>
                <div class="bg-white p-4 rounded-lg shadow-sm border border-indigo-50">
                    <div class="text-xs font-bold text-indigo-500 uppercase mb-1">フェーズ2 (理論)</div>
                    <div class="font-bold text-slate-800">数理統計学の教科書</div>
                    <p class="text-xs text-slate-500 mt-2">大学レベルの微分積分・線形代数の補強にも活用。</p>
                </div>
                <div class="bg-white p-4 rounded-lg shadow-sm border border-indigo-50">
                    <div class="text-xs font-bold text-indigo-500 uppercase mb-1">フェーズ3 (過去問)</div>
                    <div class="font-bold text-slate-800">統計検定1級 過去問題集</div>
                    <p class="text-xs text-slate-500 mt-2">最強の教材。最低5年分。解説の「論述の流れ」を徹底模倣。</p>
                </div>
                <div class="bg-white p-4 rounded-lg shadow-sm border border-indigo-50">
                    <div class="text-xs font-bold text-indigo-500 uppercase mb-1">補助 (数学)</div>
                    <div class="font-bold text-slate-800">マセマ等の大学数学書</div>
                    <p class="text-xs text-slate-500 mt-2">偏微分、重積分、行列計算につまずいた時の辞書として。</p>
                </div>
            </div>
        </section>

    </main>

    <footer class="bg-slate-800 text-slate-300 py-8">
        <div class="container mx-auto px-4 text-center text-sm">
            <p>&copy; 2026 統計検定1級チャレンジャー. 学習計画に基づいて作成.</p>
            <p class="mt-2 text-slate-500">継続こそ力なり。</p>
        </div>
    </footer>

    <!-- Logic Script -->
    <script>
        // --- 1. State & Data ---
        
        const targetDate = new Date('2026-11-15T09:00:00'); // Exam date
        
        // Phase Data (Source Material Integrated)
        const phases = {
            1: {
                title: "フェーズ 1: 基礎固めと苦手克服",
                period: "2025年12月 〜 2026年3月上旬",
                duration: "約3.5ヶ月 (120時間)",
                description: "統計検定2級レベルの知識を完全に定着させ、苦手意識を払拭する期間です。工学部出身のアドバンテージを活かすため、まずは「数式」よりも「概念」を日本語で説明できる状態を目指します。",
                color: "border-l-4 border-blue-500",
                goals: [
                    "記述統計・確率分布（二項・正規・ポアソン）のイメージを掴む",
                    "推測統計（点推定・区間推定）のロジック理解",
                    "仮説検定の手順とP値の意味の完全理解",
                    "2級過去問で正答率8割達成"
                ],
                schedule: [
                    { month: "12月", task: "統計の基礎概念、記述統計、確率の基本" },
                    { month: "1月", task: "統計的推測の導入（標本分布、点/区間推定）" },
                    { month: "2月", task: "仮説検定、単回帰分析、微積分の復習（必要に応じて）" },
                    { month: "3月上", task: "総復習、2級過去問演習、数検準1級範囲の確認" }
                ]
            },
            2: {
                title: "フェーズ 2: 数理基礎と数学補強",
                period: "2026年3月下旬 〜 2026年7月上旬",
                duration: "約3.5ヶ月 (120時間)",
                description: "1級「統計数理」の土台を作る最も苦しく、かつ重要な時期です。数式の「導出」にこだわり、手を動かして計算力を養います。ここで微積分や線形代数の知識を総動員します。",
                color: "border-l-4 border-indigo-500",
                goals: [
                    "モーメント母関数を用いた分布の導出",
                    "変数変換（ヤコビアン）の計算習得",
                    "最尤推定、不偏性、一致性、有効性の証明",
                    "漸近理論（デルタ法）と線形代数（行列微分）の理解"
                ],
                schedule: [
                    { month: "3月下-4月", task: "数理統計導入、変数変換、多変量正規分布" },
                    { month: "5月", task: "推定量の理論（最尤推定、クラメール・ラオ）" },
                    { month: "6月", task: "検定理論（尤度比検定）、線形代数復習" },
                    { month: "7月上", task: "数理統計の論述練習、数検1級レベルの確認" }
                ]
            },
            3: {
                title: "フェーズ 3: 応用分野と過去問",
                period: "2026年7月下旬 〜 2026年10月上旬",
                duration: "約2.5ヶ月 (90時間)",
                description: "選択科目「統計応用（社会科学）」の対策と、本格的な過去問演習に入ります。フェーズ2で培った数理知識を、社会科学の文脈（多変量解析や因果推論）でどう使うかを学びます。",
                color: "border-l-4 border-purple-500",
                goals: [
                    "多変量解析（因子・主成分・クラスター）の理解",
                    "ロジスティック回帰、因果推論の理論背景",
                    "過去問5年分演習（5問中3問選択の戦略確立）",
                    "採点基準を意識した答案作成力の養成"
                ],
                schedule: [
                    { month: "7月下-8月", task: "統計応用（社会科学）特化学習" },
                    { month: "9月", task: "1級過去問演習（統計数理）" },
                    { month: "10月上", task: "1級過去問演習（統計応用）" }
                ]
            },
            4: {
                title: "フェーズ 4: 総仕上げ",
                period: "2026年10月下旬 〜 2026年11月15日",
                duration: "約3週間 (20時間)",
                description: "本番形式でのシミュレーションを行い、時間感覚と「捨てる問題」の判断力を養います。新しいことには手を広げず、既知の知識の定着度を100%に近づけます。",
                color: "border-l-4 border-rose-500",
                goals: [
                    "90分間での解答ペース配分の体得",
                    "頻出公式・定理の最終暗記",
                    "弱点分野の補強",
                    "万全の体調管理"
                ],
                schedule: [
                    { month: "10月下", task: "時間制限付き模擬演習（数理・応用）" },
                    { month: "11月上", task: "弱点分野最終チェック、公式確認" },
                    { month: "直前", task: "シミュレーション、休養" }
                ]
            }
        };

        // --- 2. Chart Configurations ---

        function initCharts() {
            // Effort Chart (Doughnut)
            const ctxEffort = document.getElementById('effortChart').getContext('2d');
            new Chart(ctxEffort, {
                type: 'doughnut',
                data: {
                    labels: ['P1: 基礎', 'P2: 数理/数学', 'P3: 応用/過去問', 'P4: 仕上げ'],
                    datasets: [{
                        data: [120, 120, 90, 20],
                        backgroundColor: [
                            '#3b82f6', // Blue
                            '#4f46e5', // Indigo
                            '#a855f7', // Purple
                            '#f43f5e'  // Rose
                        ],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'right' }
                    }
                }
            });

            // Weekly Chart (Stacked Bar)
            const ctxWeekly = document.getElementById('weeklyChart').getContext('2d');
            new Chart(ctxWeekly, {
                type: 'bar',
                data: {
                    labels: ['月', '火', '水', '木', '金', '土', '日'],
                    datasets: [
                        {
                            label: '夜 (集中)',
                            data: [1.5, 1.5, 1.5, 1.5, 1.5, 1.5, 1.5], // 90 mins
                            backgroundColor: '#4f46e5',
                        },
                        {
                            label: '昼 (復習)',
                            data: [0.5, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5], // 30 mins
                            backgroundColor: '#f59e0b',
                        },
                        {
                            label: '通勤 (任意)',
                            data: [1, 1, 1, 1, 1, 0, 0], // 60 mins weekdays
                            backgroundColor: '#e2e8f0',
                            borderWidth: 1,
                            borderColor: '#cbd5e1',
                            borderDash: [5, 5] // Dashed to indicate optional
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: { stacked: true },
                        y: { 
                            stacked: true,
                            title: { display: true, text: '時間 (h)' },
                            max: 4
                        }
                    },
                    plugins: {
                        tooltip: {
                            callbacks: {
                                footer: (items) => {
                                    return items[0].dataset.label === '通勤 (任意)' ? '※睡眠・休息に充ててもOK' : '';
                                }
                            }
                        }
                    }
                }
            });
        }

        // --- 3. DOM Manipulation & Interaction ---

        function updateCountdown() {
            const now = new Date();
            const diffTime = targetDate - now;
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            
            const el = document.getElementById('days-remaining');
            if (diffDays > 0) {
                el.innerText = diffDays;
            } else {
                el.innerText = "0";
                // Optionally handle exam day passed
            }
        }

        function renderPhaseContent(phaseId) {
            const p = phases[phaseId];
            const container = document.getElementById('phase-content');
            
            // Clear current content
            container.innerHTML = '';

            // Create HTML structure
            const html = `
                <div class="fade-in p-6 md:p-8 h-full flex flex-col ${p.color}">
                    <div class="flex justify-between items-start mb-4">
                        <div>
                            <span class="inline-block px-2 py-1 bg-slate-100 text-slate-600 rounded text-xs font-bold mb-2">${p.period}</span>
                            <h3 class="text-2xl font-bold text-slate-800">${p.title}</h3>
                        </div>
                        <div class="text-right">
                            <span class="text-xs text-slate-500 uppercase">目安時間</span>
                            <div class="font-bold text-indigo-600">${p.duration}</div>
                        </div>
                    </div>

                    <p class="text-slate-600 mb-6 leading-relaxed">${p.description}</p>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-auto">
                        <div class="bg-slate-50 rounded-xl p-5">
                            <h4 class="font-bold text-slate-700 mb-3 flex items-center gap-2">
                                <span>🎯</span> 達成目標
                            </h4>
                            <ul class="space-y-2">
                                ${p.goals.map(g => `<li class="flex items-start gap-2 text-sm text-slate-600"><span class="text-green-500 font-bold">✓</span>${g}</li>`).join('')}
                            </ul>
                        </div>
                        
                        <div class="bg-white border border-slate-200 rounded-xl overflow-hidden">
                            <h4 class="bg-slate-100 px-5 py-3 font-bold text-slate-700 border-b border-slate-200 text-sm">
                                月別スケジュール
                            </h4>
                            <div class="divide-y divide-slate-100">
                                ${p.schedule.map(s => `
                                    <div class="px-5 py-3 flex gap-4 hover:bg-slate-50 transition-colors">
                                        <div class="w-16 font-bold text-indigo-500 text-sm shrink-0">${s.month}</div>
                                        <div class="text-sm text-slate-600">${s.task}</div>
                                    </div>
                                `).join('')}
                            </div>
                        </div>
                    </div>
                </div>
            `;
            
            container.innerHTML = html;
        }

        function setupTabs() {
            const buttons = document.querySelectorAll('.phase-btn');
            buttons.forEach(btn => {
                btn.addEventListener('click', () => {
                    // Remove active class from all
                    buttons.forEach(b => b.classList.remove('active', 'bg-indigo-50'));
                    // Add active class to clicked
                    btn.classList.add('active');
                    
                    // Render content
                    const phaseId = btn.getAttribute('data-phase');
                    renderPhaseContent(phaseId);
                });
            });
        }

        // --- 4. Initialization ---

        document.addEventListener('DOMContentLoaded', () => {
            updateCountdown();
            initCharts();
            setupTabs();
            
            // Initial render (Phase 1)
            renderPhaseContent(1);
        });

    </script>
    
    <!-- Visualization & Content Choices: 
         - Countdown: Immediate urgency/context setting.
         - Doughnut Chart: Shows the "heavy lifting" is in the first half (Basics + Theory).
         - Stacked Bar Chart: Visualizes the "Optional Commute" strategy clearly (dashed border).
         - Tabbed Phase View: Prevents cognitive overload by hiding future details until requested, focusing the user on one stage at a time.
         - Color Coding: Consistent Indigo theme for "Night Study/Core", Amber for "Review", Slate for "Optional".
         - CONFIRMATION: No SVG graphics used. No Mermaid JS used. All visual elements are HTML/CSS or Chart.js Canvas.
    -->
</body>
</html>
